<%= render "styles" %>
<div class="magic-import">
  <h2 class="heading"><%= t("ao3_backup.title") %></h2>
  <p class="intro">Inspect a public AO3 work, then choose and edit its metadata before importing. A chapter URL retrieves the whole published work.</p>
  <p class="notice">Review only: saving to the archive is not enabled yet. No works, chapters, or tags will be created.</p>
  <%= form_tag import_sessions_path, class: "simple post" do %>
    <fieldset>
      <legend>Source work</legend>
      <dl>
        <dt><%= label_tag :source_url, "AO3 work or chapter URL" %></dt>
        <dd><%= url_field_tag :source_url, params[:source_url], required: true, placeholder: "https://archiveofourown.org/works/…", size: 70 %></dd>
      </dl>
      <p class="muted">Fetching runs in the background. Cached snapshots are retained until you delete the review.</p>
      <p class="submit actions"><%= submit_tag "Fetch and inspect" %></p>
    </fieldset>
  <% end %>
  <% if @sessions.any? %>
    <h3 class="heading">Recent reviews</h3>
    <ul class="index group">
      <% @sessions.each do |session| %>
        <li>
          <% if session.state == "ready" && session.selection.is_a?(Hash) && (snapshot = session.current_snapshot) %>
            <% title_field = session.selection.dig("scalars", "title") || {} %>
            <% title = title_field["keep"] ? title_field["value"] : title_field["replacement"] %>
            <% authors = Array(snapshot.manifest["authors"]).join(", ") %>
            <%= link_to truncate(title.presence || "AO3 work #{session.source_work_id}", length: 80), import_session_path(session) %><% if authors.present? %> — Author<%= "s" if snapshot.manifest["authors"].size != 1 %>: <%= truncate(authors, length: 60) %><% end %><% if title.present? %> — AO3 work <%= session.source_work_id %><% end %>
          <% else %>
            <%= link_to "AO3 work #{session.source_work_id}", import_session_path(session) %>
          <% end %>
          — <%= session.state.humanize %> <span class="muted">(<%= session.created_at.utc.strftime("%Y-%m-%d %H:%M UTC") %>)</span>
          <%= link_to "Delete", confirm_delete_import_session_path(session), aria: { label: "Delete review for AO3 work #{session.source_work_id}" }, data: { confirm: "Delete this review and its temporary snapshot and choices?" } %>
        </li>
      <% end %>
    </ul>
  <% end %>
</div>
