<% use_tinymce %>
<%= form_tag import_session_path(@import_session), method: :patch, class: "verbose post work", id: "magic-selection-form" do %>
  <%= hidden_field_tag :revision, @import_session.selection_revision %>
  <%= hidden_field_tag :digest, @import_session.snapshot_digest %>
  <%= hidden_field_tag :layout, params[:layout] == "new_work" ? "new_work" : "review" %>
  <nav aria-label="Review layout" class="actions">
    <button type="submit" name="switch_layout" value="review" formnovalidate>Current review</button>
    <button type="submit" name="switch_layout" value="new_work" formnovalidate>New Work layout</button>
    <span>Switching saves your review choices.</span>
  </nav>
  <% if params[:layout] == "new_work" %>
    <%= render "new_work_tags" %>
  <% else %>
  <fieldset class="tags" role="article" id="magic-tags">
    <legend>Tags</legend>
    <h3 class="landmark heading">Tags</h3>
    <p class="muted">Author tags come first. Existing local tags start selected; new tags start unchecked. Ratings and warnings start unchecked even if they exist locally. Renaming preserves your keep choice.</p>
    <div class="toolbar">
      <%= label_tag :magic_tag_search, "Find tags" %><%= search_field_tag nil, nil, id: "magic_tag_search", placeholder: "Search names" %>
      <%= label_tag :magic_tag_type, "Type" %><%= select_tag nil, options_for_select([['All types', '']] + Ao3Backup::LocalTagResolver::TYPES.map { |type| [type, type] }), id: "magic_tag_type" %>
      <button type="button" id="magic-select-visible">Select visible</button><button type="button" id="magic-clear-visible">Clear visible</button>
    </div>
    <% fetched_tags = @snapshot.manifest["authors"].map { |name| { "name" => name, "type" => "Freeform" } } + @snapshot.manifest["tags"] %>
    <% tag_groups = [["Source authors", "author"], ["Rating", "Rating"], ["Archive Warnings", "ArchiveWarning"], ["Fandoms", "Fandom"], ["Categories", "Category"], ["Relationships", "Relationship"], ["Characters", "Character"], ["Additional Tags", "Freeform"]] %>
    <% tag_groups.each do |heading, type| %>
      <section class="magic-tag-group" data-tag-group="<%= type %>">
        <h4 class="heading"><%= heading %></h4>
        <% candidates = @selection["tags"].select { |tag| type == "author" ? tag["author"] : !tag["author"] && tag["type"] == type } %>
        <% if candidates.empty? %><p class="muted">None fetched.</p><% end %>
        <ul class="tag-candidates">
      <% candidates.each do |tag| %>
        <li class="tag-candidate <%= 'author' if tag['author'] %>" data-type="<%= tag['type'] %>">
          <span><%= hidden_field_tag "selection[tags][#{tag['id']}][id]", tag["id"], id: nil %><%= hidden_field_tag "selection[tags][#{tag['id']}][keep]", "0", id: nil %><%= check_box_tag "selection[tags][#{tag['id']}][keep]", "1", tag["keep"], id: "tag_keep_#{tag['id']}", aria: { label: "Keep #{tag['type']} #{tag['name']}" } %></span>
          <span><%= label_tag "tag_name_#{tag['id']}", "#{tag['author'] ? 'Author · ' : ''}#{tag['type']}" %><%= text_field_tag "selection[tags][#{tag['id']}][name]", tag["name"], id: "tag_name_#{tag['id']}" %><br><span class="muted">Fetched: <%= tag["id"].start_with?("added-") ? "Added during review" : fetched_tags.fetch(tag["id"].to_i)["name"] %></span></span>
          <span class="tag-status"><span class="badge"><%= tag["status"] == "new" ? "New tag" : tag["status"].humanize %></span><% if tag["author"] %><span class="badge">Author first</span><% end %><br><span class="muted"><% if tag["local_id"] %>Local <%= tag["local_type"] %> #<%= tag["local_id"] %>: <%= tag["local_name"] %><% elsif tag["local_type"] %>Name belongs to <%= tag["local_type"] %>. Edit or remove this choice.<% else %>Will create a tag if selected in a future save.<% end %></span></span>
        </li>
      <% end %>
        </ul>
      </section>
    <% end %>
  </fieldset>
  <% end %>
  <fieldset class="preface" role="article" id="magic-preface">
    <legend>Preface</legend>
    <h3 class="landmark heading">Preface</h3>
    <p class="note">Edit the proposed values or uncheck a field to omit it. A title and language require a local replacement when unchecked.</p>
    <p class="note">Source authors are reviewed as author tags above. The local account's byline is not selected in this review.</p>
    <dl>
      <% %w[title summary notes endnotes].each do |name| %>
        <%= render "scalar_field", name: name, field: @selection["scalars"].fetch(name) %>
      <% end %>
    </dl>
  </fieldset>
  <fieldset id="magic-associations" role="article">
    <legend>Associations</legend>
    <h3 class="landmark heading">Associations</h3>
    <p class="note">Collections, gifts, related works, and work skins are not configured in this review. Series is source attribution only; no local series is created.</p>
    <dl>
      <% %w[series expected_chapters published_at language status_date status_label source_attribution].each do |name| %>
        <%= render "scalar_field", name: name, field: @selection["scalars"].fetch(name) %>
      <% end %>
    </dl>
  </fieldset>
  <fieldset class="privacy" role="article" id="magic-privacy">
    <legend>Privacy</legend>
    <h3 class="landmark heading">Privacy</h3>
    <p class="note">Visibility and commenting permissions are not configured in this review. No work is posted or saved.</p>
  </fieldset>
  <fieldset class="work text" role="article" id="magic-work-text">
    <legend>Work Text</legend>
    <h3 class="landmark heading">Work Text</h3>
    <p class="muted">All published bodies stay in source order. Chapter identifiers are technical source identities. Titles, summaries, and notes remain independent choices.</p>
    <% @selection["chapters"].each do |chapter| %>
      <div class="chapter">
        <h4>Chapter <%= chapter["position"] %><%= ": #{chapter['title']}" if chapter['title'].present? %></h4>
        <p class="muted">Source chapter ID: <%= chapter["source_chapter_id"] || "Not exposed by source" %></p>
        <% chapter["fields"].each do |name, field| %>
          <div class="field">
            <% key = "chapter_#{chapter['position']}_#{name}" %>
            <%= label_tag key, "Chapter #{chapter['position']} #{name.humanize.downcase}" %>
            <span class="keep"><%= hidden_field_tag "selection[chapters][#{chapter['position']}][#{name}][keep]", "0", id: nil %><%= check_box_tag "selection[chapters][#{chapter['position']}][#{name}][keep]", "1", field["keep"], id: "keep_#{key}" %> <%= label_tag "keep_#{key}", "Keep #{name}" %></span>
            <% if name == "title" %>
              <%= text_field_tag "selection[chapters][#{chapter['position']}][#{name}][value]", field["value"], id: key %>
            <% else %>
              <%= render "rich_text_field", name: "selection[chapters][#{chapter['position']}][#{name}][value]", value: field["value"], field_id: key %>
            <% end %>
            <details><summary>Fetched source value</summary><pre><%= @snapshot.manifest["chapters"].find { |source| source["position"] == chapter["position"] }[name].presence || "Absent" %></pre></details>
          </div>
        <% end %>
        <details class="magic-chapter-inspection" id="inspect-chapter-<%= chapter['position'] %>">
          <summary>Inspect chapter <%= chapter["position"] %> body</summary>
          <div class="magic-chapter-scroll userstuff" tabindex="0" aria-label="Chapter <%= chapter['position'] %> body"><%= chapter["content"].html_safe %></div>
          <button type="button" class="magic-collapse-chapter">Collapse chapter <%= chapter["position"] %> body</button>
        </details>
      </div>
    <% end %>
  </fieldset>
  <p class="submit actions"><%= submit_tag "Update review" %></p>
<% end %>
<section class="preview" id="magic-proposed-output">
  <h3 class="heading">Exact proposed output</h3>
  <p class="muted">This preview reflects the saved review revision. Apply changes with “Update review” to refresh it.</p>
  <h4><%= @proposed.dig("scalars", "title") %></h4>
  <dl class="meta group">
    <% @proposed["scalars"].except("title", "summary", "notes", "endnotes").each do |name, value| %><dt><%= name.humanize %></dt><dd><%= value.presence || "Omitted" %></dd><% end %>
  </dl>
  <h4>Selected tags in display order</h4>
  <ol><% @proposed["tags"].each do |tag| %><li><%= tag["name"] %> <span class="badge"><%= tag["type"] %></span> <%= "(new)" unless tag["local_id"] %></li><% end %></ol>
  <% if @proposed["tags"].empty? %><p>No tags selected.</p><% end %>
  <% %w[summary notes endnotes].each do |name| %><h4><%= name.humanize %></h4><div class="userstuff"><%= @proposed["scalars"][name].present? ? @proposed["scalars"][name].html_safe : "Omitted" %></div><% end %>
  <h4>Chapters</h4>
  <% @proposed["chapters"].each do |chapter| %>
    <details class="magic-chapter-inspection"><summary>Chapter <%= chapter["position"] %><%= ": #{chapter['title']}" if chapter['title'].present? %></summary>
      <div class="magic-chapter-scroll" tabindex="0" aria-label="Proposed chapter <%= chapter['position'] %>">
        <% %w[summary notes content endnotes].each do |name| %><h5><%= name.humanize %></h5><div class="userstuff"><%= chapter[name].present? ? chapter[name].html_safe : "Omitted" %></div><% end %>
      </div>
      <button type="button" class="magic-collapse-chapter">Collapse proposed chapter <%= chapter["position"] %></button>
    </details>
  <% end %>
  <% if @snapshot.manifest["remote_dependencies"].any? %><h4>Remote media dependencies</h4><p class="muted">These media remain externally hosted; no media is copied.</p><ul><% @snapshot.manifest["remote_dependencies"].each do |url| %><li><%= url %></li><% end %></ul><% end %>
  <p><button disabled type="button">Save to archive (not enabled yet)</button></p>
</section>
<script>
(function () {
  var rows = Array.from(document.querySelectorAll('.magic-import .tag-candidate'));
  var search = document.getElementById('magic_tag_search'), type = document.getElementById('magic_tag_type');
  function filter() {
    var query = search.value.toLocaleLowerCase();
    rows.forEach(function (row) { row.hidden = (type.value && row.dataset.type !== type.value) || row.querySelector('input[type=text]').value.toLocaleLowerCase().indexOf(query) < 0; });
  }
  if (!search || !type) return;
  search.addEventListener('input', filter); type.addEventListener('change', filter);
  document.getElementById('magic-select-visible').addEventListener('click', function () { rows.filter(function (row) { return !row.hidden; }).forEach(function (row) { row.querySelector('input[type=checkbox]').checked = true; }); });
  document.getElementById('magic-clear-visible').addEventListener('click', function () { rows.filter(function (row) { return !row.hidden; }).forEach(function (row) { row.querySelector('input[type=checkbox]').checked = false; }); });
})();
</script>

<% content_for :footer_js do %>
<script>
$j(function () {
  var fields = Array.from(document.querySelectorAll('.magic-rich-editor'));
  // TinyMCE normalizes some archive-allowed HTML even before a user edits it.
  // Keep the exact textarea value until the editor content actually changes.
  function showEditor(field) {
    if (field.dataset.mode !== 'rich' || tinyMCE.get(field.dataset.editorId)) return;
    addEditor(field.dataset.editorId);
    var editor = tinyMCE.get(field.dataset.editorId);
    if (!editor) return;
    var originalSave = editor.save;
    var initialContent;
    editor.save = function () {
      var changed = initialContent !== undefined && editor.getContent() !== initialContent;
      var result = originalSave.apply(editor, arguments);
      if (!changed) field.querySelector('textarea').value = field.originalValue;
      return result;
    };
    editor.on('init', function () { initialContent = editor.getContent(); });
  }
  var observer = window.IntersectionObserver ? new IntersectionObserver(function (entries) {
    entries.forEach(function (entry) { if (entry.isIntersecting) { showEditor(entry.target); observer.unobserve(entry.target); } });
  }, {rootMargin: '200px'}) : null;
  fields.forEach(function (field) {
    var textarea = field.querySelector('textarea');
    field.originalValue = textarea.value;
    field.dataset.mode = 'rich';
    if (observer) observer.observe(field); else showEditor(field);
    field.querySelectorAll('[data-editor-mode]').forEach(function (button) {
      button.addEventListener('click', function () {
        var mode = button.dataset.editorMode;
        if (field.dataset.mode === mode) return;
        if (mode === 'html') {
          removeEditor(field.dataset.editorId);
          field.originalValue = textarea.value;
        } else {
          field.originalValue = textarea.value;
        }
        field.dataset.mode = mode;
        if (mode === 'rich') showEditor(field);
        field.querySelectorAll('[data-editor-mode]').forEach(function (control) { control.setAttribute('aria-pressed', String(control === button)); });
      });
    });
  });
  document.getElementById('magic-selection-form').addEventListener('submit', function () { tinyMCE.triggerSave(); });
  document.querySelectorAll('.magic-collapse-chapter').forEach(function (button) {
    button.addEventListener('click', function () {
      var details = button.closest('details');
      details.open = false;
      details.querySelector('summary').focus();
    });
  });
});
</script>
<% end %>
